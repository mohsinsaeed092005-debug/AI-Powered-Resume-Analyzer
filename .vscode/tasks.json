{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Claude Dashboard",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/ai-resume-system"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start Resume Analyzer",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {
          "PORT": "3001"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start Both Apps",
      "dependsOn": ["Start Claude Dashboard", "Start Resume Analyzer"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
