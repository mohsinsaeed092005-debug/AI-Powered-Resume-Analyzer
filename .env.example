# Root environment template (copy to .env for local Python backend + shared keys)
# Do NOT commit .env — add the same variables in Vercel / your host dashboard.

# MongoDB (use MongoDB Atlas in production; localhost only for local dev)
MONGODB_URI=mongodb://localhost:27017
# Alias supported by frontend/backend: MONGO_URI=

# OpenRouter (primary AI provider for Python backend and optional frontend)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-4o

# Groq (optional alternative for frontend — if set, Groq is used instead of OpenRouter)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: local sentence-transformers model path (Python backend)
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
