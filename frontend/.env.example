# Resume Analyzer (testing UI) — copy to .env.local for local development
# Set the same variables in Vercel if you deploy this app separately

# MongoDB
MONGODB_URI=mongodb://localhost:27017
# Alias: MONGO_URI=

# OpenRouter (used when GROQ_API_KEY is not set)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-4o

# Groq (optional — if set, takes priority over OpenRouter)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Public URL for OpenRouter HTTP-Referer (optional; Vercel sets VERCEL_URL automatically)
# NEXT_PUBLIC_APP_URL=http://localhost:3001
