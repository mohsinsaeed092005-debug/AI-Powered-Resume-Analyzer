# AI Resume System — copy to .env.local for local development
# Set the same variables in Vercel → Project → Settings → Environment Variables

# MongoDB (Atlas connection string in production)
MONGODB_URI=mongodb://localhost:27017

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional fallback keys. The app tries these in order if the first key runs out of credits/limit.
# OPENROUTER_API_KEY_2=your_second_openrouter_api_key_here
# OPENROUTER_API_KEY_3=your_third_openrouter_api_key_here
# OPENROUTER_API_KEYS=extra_key_one,extra_key_two
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-4o

# NextAuth (required for sign-in session)
NEXTAUTH_SECRET=generate_a_long_random_string_here
# Local: http://localhost:3003  |  Production: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3003

# Optional explicit app URL (auto-detected on Vercel via VERCEL_URL if omitted)
# APP_URL=
